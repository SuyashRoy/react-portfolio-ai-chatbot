# Copy to .env and fill in. Never commit .env (it is gitignored).
# Nothing here is strictly required to run the site: without keys, the chatbot
# answers from src/data/profile.json and the contact form shows an "email me" fallback.

# ---------------------------------------------------------------------------
# Backend: server.cjs (npm run server / npm run full:dev)
# ---------------------------------------------------------------------------

# Port the Express server listens on. Optional, defaults to 5000.
PORT=5000

# Required for AI chatbot replies. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model for the chatbot. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Required for the contact form. Messages are delivered to a Telegram chat.
#   TELEGRAM_BOT_TOKEN: create a bot with @BotFather
#   TELEGRAM_CHAT_ID:   the chat/group the bot posts into (group IDs start with -100)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Frontend: Vite (npm run dev / npm run build)
# Vite only exposes variables prefixed with VITE_, and bakes them in at build time.
# ---------------------------------------------------------------------------

# Base URL of the deployed backend, no trailing slash, e.g. https://api.suyashroy.me
# Optional locally (defaults to http://localhost:5000); required in production.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Legacy: server.js only (not used by any npm script). Its contact form sends email.
# ---------------------------------------------------------------------------
# EMAIL_USER=
# EMAIL_PASS=
