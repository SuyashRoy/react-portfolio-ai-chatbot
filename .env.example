# Copy to .env and fill in. Never commit .env (it is gitignored).
# Nothing here is strictly required to run the site: without keys, the chatbot
# answers from src/data/profile.json and the contact form shows an "email me" fallback.

# ---------------------------------------------------------------------------
# Backend: api/chat.js + api/contact.js (Vercel functions; server.cjs runs them locally)
# On Vercel, set these in Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Local only: port server.cjs listens on (Vite proxies /api here). Defaults to 5000.
PORT=5000

# Required for AI chatbot replies. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model for the chatbot. Defaults to gemini-3.8-flash (2.5-flash is closed to new keys).
GEMINI_MODEL=gemini-3.8-flash

# Required for the contact form. Messages are delivered to a Telegram chat.
#   TELEGRAM_BOT_TOKEN: create a bot with @BotFather
#   TELEGRAM_CHAT_ID:   the chat/group the bot posts into (group IDs start with -100)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Frontend: Vite (npm run dev / npm run build)
# Vite only exposes variables prefixed with VITE_, and bakes them in at build time.
# ---------------------------------------------------------------------------

# Optional. Leave empty to call same-origin /api/... (Vercel in production, the Vite
# proxy to server.cjs in dev). Set it only to point the frontend at a different backend.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Legacy: server.js only (not used by any npm script). Its contact form sends email.
# ---------------------------------------------------------------------------
# EMAIL_USER=
# EMAIL_PASS=
